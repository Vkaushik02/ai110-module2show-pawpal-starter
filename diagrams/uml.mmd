    class Task {
        +str description
        +str time
        +str frequency
        +bool is_complete
        +mark_complete() void
        +reschedule(new_time) void
        +is_due_today() bool
    }

    class Pet {
        +str name
        +str species
        +int age
        +list tasks
        +add_task(task) void
        +remove_task(task) void
        +get_pending_tasks() list
    }

    class Owner {
        +str name
        +list pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() list
    }

    class Scheduler {
        +Owner owner
        +get_daily_schedule() list
        +sort_by_time(tasks) list
        +detect_conflicts(tasks) list
    }

    Owner "1" --> "*" Pet : owns
