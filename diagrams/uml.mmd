classDiagram
    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Task {
        +str description
        +str time
        +Frequency frequency
        +date due_date
        +Pet pet
        +bool is_complete
        +mark_complete() Task
        +reschedule(new_time) void
        +is_due_today() bool
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task) void
        +remove_task(task) void
        +get_pending_tasks() list~Task~
    }

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) void
        +remove_pet(pet) void
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +Owner owner
        +get_daily_schedule() list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_by_status(completed) list~Task~
        +detect_conflicts(tasks) list~list~Task~~
    }

    Owner "1" --> "*" Pet : owns
    Pet "1" <--> "*" Task : has / belongs to
    Task --> Frequency : repeats
    Task ..> Task : mark_complete() creates next occurrence
    Scheduler --> Owner : reads tasks from
    Scheduler ..> Task : sorts, filters, detects conflicts
